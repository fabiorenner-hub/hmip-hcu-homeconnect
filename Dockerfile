# Multi-stage build (arm64 = HCU). The app is bundled into a single
# self-contained dist/plugin/index.js (esbuild) so it can run both as the
# baked-in image bundle and as an OTA payload. The bootstrap loader
# (dist/bootstrap/loader.js) is the container entrypoint and decides between
# image and OTA payload with crash-loop protection + rollback.
ARG BASE_IMAGE=ghcr.io/homematicip/alpine-node-simple:0.0.1
ARG HOMECONNECT_VERSION=0.7.2

FROM ${BASE_IMAGE} AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY src ./src
COPY scripts ./scripts
RUN npm run build

FROM ${BASE_IMAGE}
ARG HOMECONNECT_VERSION
WORKDIR /app

# Fully bundled — no node_modules needed at runtime (proven self-contained).
COPY --from=build /app/dist ./dist

ENV PLUGIN_STATE_DIR=/data
ENV HOMECONNECT_VERSION=${HOMECONNECT_VERSION}
RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8123 8124

CMD ["node", "dist/bootstrap/loader.js"]

